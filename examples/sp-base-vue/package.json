{
  "name": "sp-base-vue",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "scripts": {
    "build": "esboot build",
    "dev": "esboot dev",
    "postinstall": "esboot prepare",
    "preview": "esboot preview",
    "test:unit": "vitest",
    "type-check": "vue-tsc --build",
    "prepare": "esboot prepare"
  },
  "commitlint": {
    "extends": [
      "./node_modules/.cache/esboot/commitlint"
    ]
  },
  "dependencies": {
    "@dz-web/esboot-browser": "workspace:*",
    "@vue/test-utils": "^2.4.6",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@dz-web/esboot": "workspace:*",
    "@dz-web/esboot-bundler-vite": "workspace:*",
    "@dz-web/esboot-plugin-docs": "workspace:*",
    "@dz-web/esboot-plugin-vitest": "workspace:*",
    "@dz-web/esboot-plugin-vue": "workspace:*",
    "@types/node": "^22.16.5",
    "eslint": "^10.1.0",
    "stylelint": "^17.5.0",
    "vue-tsc": "^3.0.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint",
    "*.{scss,css}": "stylelint"
  },
  "browserslist": {
    "development": [
      "last 1 chrome version"
    ],
    "production": [
      "Chrome >= 67"
    ]
  },
  "prettier": "./node_modules/.cache/esboot/prettier",
  "stylelint": {
    "extends": [
      "./node_modules/.cache/esboot/stylelint"
    ]
  }
}
