{
  "name": "example-sp-base",
  "version": "1.0.0",
  "private": "true",
  "description": "",
  "author": "Roc",
  "license": "ISC",
  "sideEffects": [
    "./src/**/*.scss",
    "./src/**/*.css"
  ],
  "main": "index.js",
  "scripts": {
    "dev:vite": "cross-env ESBOOT_BUNDLER=vite bun run sync-esbootrc.ts && esboot dev",
    "dev:webpack": "cross-env ESBOOT_BUNDLER=webpack bun run sync-esbootrc.ts && esboot dev",
    "dev:rspack": "cross-env ESBOOT_BUNDLER=rspack bun run sync-esbootrc.ts && esboot dev",
    "build:vite": "cross-env ESBOOT_BUNDLER=vite bun run sync-esbootrc.ts && esboot build",
    "build:webpack": "cross-env ESBOOT_BUNDLER=webpack bun run sync-esbootrc.ts && esboot build",
    "build:rspack": "cross-env ESBOOT_BUNDLER=rspack bun run sync-esbootrc.ts && esboot build",
    "postinstall": "esboot prepare",
    "preview": "cross-env esboot preview",
    "test:unit": "vitest",
    "type-check": "vue-tsc --build",
    "prepare": "esboot prepare"
  },
  "dependencies": {
    "@dz-web/axios": "^0.0.6",
    "@dz-web/axios-middlewares": "^1.3.0",
    "@dz-web/esboot-browser": "workspace:*",
    "@dz-web/esboot-browser-react": "workspace:*",
    "@dz-web/esboot-plugin-tailwind3": "workspace:*",
    "@loadable/component": "^5.16.7",
    "@swc/helpers": "^0.5.23",
    "@tanstack/react-query": "^5.101.0",
    "ahooks": "^3.9.7",
    "antd": "^6.4.3",
    "axios": "^1.17.0",
    "lodash-es": "^4.18.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-intl": "^7.1.14",
    "react-router-dom": "^7.17.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@dz-web/esboot": "workspace:*",
    "@dz-web/esboot-bundler-rspack": "workspace:*",
    "@dz-web/esboot-bundler-vite": "workspace:*",
    "@dz-web/esboot-bundler-webpack": "workspace:*",
    "@dz-web/esboot-plugin-docs": "workspace:*",
    "@dz-web/esboot-plugin-vitest": "workspace:*",
    "@types/node": "^25.9.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.4.1",
    "stylelint": "^17.13.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint",
    "*.{scss,css}": "stylelint"
  },
  "stylelint": {
    "extends": [
      "./node_modules/.cache/esboot/stylelint"
    ]
  },
  "commitlint": {
    "extends": [
      "./node_modules/.cache/esboot/commitlint"
    ]
  },
  "prettier": "./node_modules/.cache/esboot/prettier",
  "browserslist": {
    "development": [
      "last 1 chrome version"
    ],
    "production": [
      "Chrome >= 67"
    ]
  }
}
