{
  "name": "esboot",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=7.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:browser": "turbo run dev --filter @dz-web/esboot-browser",
    "dev:base": "turbo run dev --filter @dz-web/esboot-common --filter @dz-web/esboot-lint  --filter @dz-web/esboot-bundler-common --filter @dz-web/esboot --filter @dz-web/esboot-plugin-vue --filter @dz-web/esboot-plugin-vitest --filter @dz-web/esboot-plugin-docs --filter @dz-web/postcss-plugin-esboot --filter @dz-web/esboot-browser --filter @dz-web/esboot-browser-react ",
    "dev:webpack": "pnpm run dev:base --filter @dz-web/esboot-bundler-webpack",
    "dev:vite": "pnpm run dev:base --filter @dz-web/esboot-bundler-vite",
    "dev:rspack": "pnpm run dev:base --filter @dz-web/esboot-bundler-rspack",
    "dev:sp": "cd examples/sp-base && pnpm run dev",
    "dev:mp": "cd examples/mp-base && pnpm run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint:turbo": "turbo run lint",
    "lint": "eslint packages/**/src/**/*.ts",
    "test": "vitest",
    "test:examples": "pnpm --filter example-* -r exec pnpm run test -- -p run",
    "pub": "pnpm run test run && lerna publish --force-publish=* --no-private",
    "biome": "biome",
    "clean:dep": "pnpm -r exec -- rm -rf node_modules && rm -rf node_modules && rm pnpm-lock.yaml",
    "clean:dist": "pnpm -r exec -- rm -rf dist",
    "restore-version": "bun run scripts/restore-version.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@types/bun": "^1.3.2",
    "@types/node": "^24.10.0",
    "@vitest/ui": "^4.0.8",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "lerna": "^9.0.0",
    "prettier": "latest",
    "tsdown": "^0.17.3",
    "turbo": "^2.6.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "pnpm": {
    "overrides": {
      "nx": "22.0.3"
    }
  },
  "volta": {
    "node": "22.12.0",
    "pnpm": "10.14.0"
  }
}
